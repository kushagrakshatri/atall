<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): messagesInstalled() and resolving the smsto: draft. -->
    <queries>
        <package android:name="com.google.android.apps.messaging" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application>
        <!-- The user grants notification access in Settings. No SMS permissions are used. -->
        <service
            android:name="app.atall.agents.text.android.TextAgentListenerService"
            android:exported="true"
            android:label="Agent texts"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>
    </application>
</manifest>
