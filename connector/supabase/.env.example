# Local `supabase functions serve atall --no-verify-jwt --env-file supabase/.env.local`
# (copy to supabase/.env.local; never commit it). SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected.
ATALL_OWNER_CODE=local-owner-code
ATALL_ADMIN_TOKEN=local-admin-token-0123456789
ATALL_PUBLIC_URL=http://127.0.0.1:54321/functions/v1/atall
ATALL_DEV_PAGE=true
ATALL_SEED_TASK=true
ATALL_ALLOWED_ORIGINS=
# ATALL_CONSENT_URL=https://atall-ui.pages.dev/consent.html
# C1: P-256 PKCS8 (base64). Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# ATALL_RELAY_SIGNING_KEY=
