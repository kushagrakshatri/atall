<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- One notification when a talk's answer lands (Android 13+ asks the first time a talk starts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- C2: keep running while Juno waits on agents over the Atall connector (one silent notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- C3: Approve on an agent's purchase/booking request needs a fingerprint (BiometricPrompt + Keystore). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <!-- C3: a wake tap opens the agent's own app when it's installed. -->
        <package android:name="com.anthropic.claude" />
        <package android:name="ai.x.grok" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.whatsapp" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Custom Tabs for Sign in with ChatGPT (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".AtallApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atall">
        <!-- Sentry starts from AtallApp only when a DSN exists (build-time or the hidden Settings field). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Return from OpenAI's sign-in page (explicit package in the intent:// URL). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="atall-signin" android:host="signin" />
            </intent-filter>
        </activity>
        <!-- C3: the tap on a wake notification (copies the prompt, opens the agent's app, closes at once). -->
        <activity
            android:name=".WakeTapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".ConnectorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
